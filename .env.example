# Supabase
# Lovable normally provides the browser-safe VITE_* values when the project is connected.
# Server-side auth accepts these directly, so duplicate SUPABASE_URL /
# SUPABASE_PUBLISHABLE_KEY values are optional.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side aliases for the same public project values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for trusted server-side access to app_user_access.
# Never expose this with a VITE_ prefix or in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated session cookie signing secret (32+ random characters).
# If omitted, the server derives a signing key from SUPABASE_SERVICE_ROLE_KEY.
SESSION_SECRET=

# Owner is automatically an admin. All other verified @met.com accounts
# are automatically approved as normal users.
NATURAL_GAS_OWNER_EMAIL=milan.terzic@met.com

# Data-source credentials.
AGSI_API_KEY=
ENTSOE_API_TOKEN=
VISUAL_CROSSING_API_KEY=
